{
  "manifest_version": 3,
  "name": "Lumina Tab — Simple & Elegant New Tab",
  "version": "1.0.0",
  "description": "A clean, customizable, privacy-first new tab page inspired by Tabliss. Works on Chrome, Firefox, Edge, Brave, Opera, and Vivaldi.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lumina-tab@luminatab.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
